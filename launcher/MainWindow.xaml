<Window x:Class="GlazeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GlazeLauncher"
        Title="GlazeLauncher" Width="720" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <Style x:Key="ResultContainer" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,7" Margin="0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ResultTemplate" DataType="{x:Type local:ResultItem}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="{Binding Glyph}" Visibility="{Binding GlyphVisibility}" FontFamily="{StaticResource IconFont}"
                     FontSize="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Subtitle}" Visibility="{Binding SubtitleVisibility}" FontSize="12"
                     Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Column="2" Visibility="{Binding BadgeVisibility}" Background="{StaticResource BadgeBrush}"
                CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Badge}" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
        </Border>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="{StaticResource InputBrush}" CornerRadius="9" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Apps, windows, commands…   @3 → workspace 3"
                   Foreground="{StaticResource MutedBrush}" FontSize="18" VerticalAlignment="Center"
                   Margin="3,0,0,0" IsHitTestVisible="False"/>
        <TextBox x:Name="QueryBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}"
                 SelectionBrush="{StaticResource AccentBrush}" FontSize="18" VerticalContentAlignment="Center"
                 TextChanged="QueryBox_TextChanged"/>
        <Border x:Name="TargetChip" Grid.Column="2" CornerRadius="5" Padding="8,2" Margin="10,0,0,0"
                Background="{StaticResource BadgeBrush}" VerticalAlignment="Center">
          <TextBlock x:Name="TargetText" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </Border>
      </Grid>
    </Border>

    <ListBox x:Name="Results" Grid.Row="1" Margin="0,8,0,0" MaxHeight="468"
             Background="Transparent" BorderThickness="0" Focusable="False" Foreground="{StaticResource TextBrush}"
             ItemContainerStyle="{StaticResource ResultContainer}" ItemTemplate="{StaticResource ResultTemplate}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             PreviewMouseLeftButtonUp="Results_PreviewMouseLeftButtonUp"/>

    <TextBlock x:Name="Footer" Grid.Row="2" Margin="4,8,4,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
               TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
