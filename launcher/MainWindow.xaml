<Window x:Class="GlazeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GlazeLauncher"
        Title="GlazeLauncher" Width="720" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <Style x:Key="ResultContainer" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Background="Transparent" Margin="0,1">
              <Border x:Name="RowSurface" CornerRadius="7" BorderThickness="1" IsHitTestVisible="False"/>
              <Border x:Name="SelectionAccent" Background="{StaticResource AccentBrush}" Width="2" Height="20"
                      CornerRadius="1" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter Margin="10,7"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource SelBrush}"/>
                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
                <Setter TargetName="SelectionAccent" Property="Opacity" Value="1"/>
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                  <Condition Binding="{Binding Path=(SystemParameters.ClientAreaAnimation)}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard Name="RevealSelection">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="SelectionAccent" Storyboard.TargetProperty="Opacity"
                                       From="0.3" To="1" Duration="0:0:0.085" FillBehavior="Stop"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <RemoveStoryboard BeginStoryboardName="RevealSelection"/>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Section headers take no hover or clicks (action rows have no IsHeader: the fallback keeps them normal). -->
        <DataTrigger Binding="{Binding IsHeader, FallbackValue=False}" Value="True">
          <Setter Property="IsHitTestVisible" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ResultTemplate" DataType="{x:Type local:ResultItem}">
      <Grid>
      <!-- Section header in the mixed results: a small label and, at the right, how to see the whole section. -->
      <DockPanel Visibility="{Binding HeaderVisibility}" Margin="-4,4,0,-3">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Bottom"/>
        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                   VerticalAlignment="Bottom"/>
      </DockPanel>
      <Grid Visibility="{Binding RowVisibility}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="{Binding Glyph}" Visibility="{Binding GlyphVisibility}" FontFamily="{StaticResource IconFont}"
                     FontSize="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <!-- Left-aligned, so the alias tag sits right after the title and the title still trims when long. -->
          <DockPanel HorizontalAlignment="Left">
            <Border DockPanel.Dock="Right" Visibility="{Binding AliasVisibility}" BorderBrush="{StaticResource SelectionBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="5,0,6,0" Margin="8,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,4,0"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <local:HighlightedTextBlock Value="{Binding AliasText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                            VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <local:HighlightedTextBlock Value="{Binding TitleText}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <local:HighlightedTextBlock Value="{Binding SubtitleText}" Visibility="{Binding SubtitleVisibility}" FontSize="12"
                                      Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Column="2" Visibility="{Binding BadgeVisibility}" Background="{StaticResource BadgeBrush}"
                CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Badge}" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
        </Border>
      </Grid>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ActionTemplate" DataType="{x:Type local:ActionRow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="32"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Ctrl+N runs this row -->
        <TextBlock Grid.Column="0" Text="{Binding NumberLabel}" Visibility="{Binding NumberVisibility}" FontSize="11.5"
                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   ToolTip="Ctrl+number runs this row"/>
        <TextBlock x:Name="ActionGlyph" Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
        <DockPanel Grid.Column="2" VerticalAlignment="Center" LastChildFill="True">
          <local:HighlightedTextBlock x:Name="ActionTitle" DockPanel.Dock="Left" Value="{Binding TitleText}" FontSize="14"
                                      TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" FontSize="12" Margin="10,0,0,0"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Border Grid.Column="3" Visibility="{Binding ShortcutVisibility}" Background="{StaticResource BadgeBrush}"
                CornerRadius="5" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding ShortcutLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
          <Setter TargetName="ActionGlyph" Property="Foreground" Value="{StaticResource DangerBrush}"/>
          <Setter TargetName="ActionTitle" Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsInert}" Value="True">
          <Setter TargetName="ActionGlyph" Property="Foreground" Value="{StaticResource MutedBrush}"/>
          <Setter TargetName="ActionTitle" Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsArmed}" Value="True">
          <Setter TargetName="ActionTitle" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="LauncherContent" Margin="12">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="OpenOffset"/>
    </Grid.RenderTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="{StaticResource InputBrush}" CornerRadius="9" BorderThickness="1" Padding="13,9">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SearchGlyph" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <!-- In the action list: the result being acted on, and the submenu path. -->
        <Border x:Name="Crumb" Visibility="Collapsed" Background="{StaticResource BadgeBrush}" CornerRadius="5"
                Padding="6,2,8,2" Margin="0,0,10,0" VerticalAlignment="Center" MaxWidth="330">
          <StackPanel Orientation="Horizontal">
            <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
              <Image x:Name="CrumbIcon" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="CrumbGlyph" FontFamily="{StaticResource IconFont}" FontSize="13"
                         Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="CrumbText" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Apps, windows, commands…   @3 → workspace 3"
                   Foreground="{StaticResource MutedBrush}" FontSize="18" VerticalAlignment="Center"
                   Margin="3,0,0,0" IsHitTestVisible="False"/>
        <TextBox x:Name="QueryBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}"
                 SelectionBrush="{StaticResource AccentBrush}" FontSize="18" VerticalContentAlignment="Center"
                 TextChanged="QueryBox_TextChanged"/>
        <Border x:Name="TargetChip" Grid.Column="2" CornerRadius="5" Padding="8,2" Margin="10,0,0,0"
                Background="{StaticResource BadgeBrush}" VerticalAlignment="Center">
          <TextBlock x:Name="TargetText" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
        </Border>
      </Grid>
    </Border>

    <!-- Scope chips (built in code): the always-visible legend of the prefixes; Ctrl+Tab or a click switches. -->
    <StackPanel x:Name="ScopeStrip" Grid.Row="1" Orientation="Horizontal" Margin="2,8,0,0"/>

    <ListBox x:Name="Results" Grid.Row="2" Margin="0,6,0,0" MaxHeight="468"
             Background="Transparent" BorderThickness="0" Focusable="False" Foreground="{StaticResource TextBrush}"
             ItemContainerStyle="{StaticResource ResultContainer}" ItemTemplate="{StaticResource ResultTemplate}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             PreviewMouseLeftButtonUp="Results_PreviewMouseLeftButtonUp"/>

    <ListBox x:Name="ActionList" Grid.Row="2" Margin="0,8,0,0" MaxHeight="468" Visibility="Collapsed"
             Background="Transparent" BorderThickness="0" Focusable="False" Foreground="{StaticResource TextBrush}"
             ItemContainerStyle="{StaticResource ResultContainer}" ItemTemplate="{StaticResource ActionTemplate}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
             PreviewMouseLeftButtonUp="ActionList_PreviewMouseLeftButtonUp"/>

    <TextBlock x:Name="Footer" Grid.Row="3" Margin="4,8,4,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
               TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
